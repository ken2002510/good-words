{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/respond.js": { "maxDuration": 10, "memory": 512 },
    "api/share.js": { "maxDuration": 10, "memory": 256 },
    "api/health.js": { "maxDuration": 10, "memory": 256 },
    "app/api/respond.js": { "maxDuration": 10, "memory": 512 },
    "app/api/share.js": { "maxDuration": 10, "memory": 256 },
    "app/api/health.js": { "maxDuration": 10, "memory": 256 }
  },
  "rewrites": [
    { "source": "/", "destination": "/app/public/index.html" },
    { "source": "/index.html", "destination": "/app/public/index.html" },
    { "source": "/app.js", "destination": "/app/public/app.js" },
    { "source": "/style.css", "destination": "/app/public/style.css" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
